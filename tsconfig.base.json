{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@flow/money": ["libs/money/src/index.ts"],
      "@flow/ledger-domain": ["libs/ledger-domain/src/index.ts"],
      "@flow/ledger-postgres": ["libs/ledger-postgres/src/index.ts"],
      "@flow/simulator": ["libs/simulator/src/index.ts"],
      "@flow/simulator-oracle": ["libs/simulator-oracle/src/index.ts"],
      "@flow/ingestion-domain": ["libs/ingestion-domain/src/index.ts"],
      "@flow/ingestion-postgres": ["libs/ingestion-postgres/src/index.ts"],
      "@flow/processor-domain": ["libs/processor-domain/src/index.ts"],
      "@flow/processor-postgres": ["libs/processor-postgres/src/index.ts"],
      "@flow/bank-domain": ["libs/bank-domain/src/index.ts"],
      "@flow/bank-postgres": ["libs/bank-postgres/src/index.ts"],
      "@flow/reconciliation-domain": [
        "libs/reconciliation-domain/src/index.ts"
      ],
      "@flow/reconciliation-postgres": [
        "libs/reconciliation-postgres/src/index.ts"
      ]
    }
  }
}
