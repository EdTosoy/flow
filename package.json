{
  "name": "flow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nx run-many -t build --skip-nx-cache",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && pnpm --filter @flow/ops typecheck",
    "lint": "nx graph --file=.nx/phase1-project-graph.json && eslint . --max-warnings 0 && node tools/check-oracle-dependencies.mjs",
    "format": "prettier --write '**/*.{ts,tsx,mjs,json,yaml,css}' README.md 'docs/phase1/*.md' 'docs/phase2/*.md' 'docs/phase3/*.md' 'docs/phase4/*.md' 'docs/phase5/*.md' 'docs/phase6/*.md' 'docs/phase7/*.md' 'docs/phase8/*.md' 'docs/phase9/*.md' 'docs/phase10/*.md' 'docs/phase11/*.md' 'docs/phase12/*.md' 'docs/phase13/*.md'",
    "format:check": "prettier --check '**/*.{ts,tsx,mjs,json,yaml,css}' README.md 'docs/phase1/*.md' 'docs/phase2/*.md' 'docs/phase3/*.md' 'docs/phase4/*.md' 'docs/phase5/*.md' 'docs/phase6/*.md' 'docs/phase7/*.md' 'docs/phase8/*.md' 'docs/phase9/*.md' 'docs/phase10/*.md' 'docs/phase11/*.md' 'docs/phase12/*.md' 'docs/phase13/*.md'",
    "test:unit": "nx run-many -t test --skip-nx-cache && pnpm test:boundaries",
    "test:integration": "tsx tools/test-postgres.ts",
    "db:migrate": "tsx tools/migrate.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:unit && pnpm test:integration",
    "simulator": "tsx tools/simulator.ts",
    "test:boundaries": "tsx --test tests/simulator-boundaries.test.ts tests/operations-boundaries.test.ts",
    "ingestion": "tsx tools/ingestion.ts",
    "processor": "tsx tools/processor.ts",
    "bank": "tsx tools/bank.ts",
    "reconciliation": "tsx tools/reconciliation.ts",
    "benchmark:grouped": "tsx tools/benchmark-grouped.ts",
    "exceptions": "tsx tools/exceptions.ts",
    "controls": "tsx tools/controls.ts",
    "worker": "tsx tools/worker.ts",
    "benchmark:workers": "tsx tools/test-postgres.ts tests/workers-load.integration.test.ts",
    "integrity": "tsx tools/integrity.ts",
    "test:resilience": "tsx tools/test-postgres.ts tests/resilience.integration.test.ts tests/resilience-load.integration.test.ts tests/resilience-restart.integration.test.ts",
    "benchmark:resilience": "tsx tools/test-postgres.ts tests/resilience-load.integration.test.ts",
    "ops:dev": "pnpm --filter @flow/ops dev",
    "ops:start": "pnpm --filter @flow/ops start",
    "ops:demo": "tsx tools/ops-demo.ts"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "23.2.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "nx": "23.2.1",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
