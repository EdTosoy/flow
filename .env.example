# Placeholder values only. Load real values through local runtime configuration.
# Never use administrator/owner credentials in either runtime process.
DATABASE_ADMIN_URL=<offline-local-migration-connection>
STRIPE_MODE=sandbox
STRIPE_ACCOUNT_ID=<sandbox-account-id>
STRIPE_SOURCE_ACCOUNT_ID=<configured-source-account-uuid>
STRIPE_INGRESS_DATABASE_URL=<source-bound-ingress-login-connection>
STRIPE_WORKER_DATABASE_URL=<source-bound-worker-login-connection>
STRIPE_SECRET_KEY=<sandbox-api-secret-or-restricted-test-key>
# One secret, or old,new while rotating; at most two, comma separated.
STRIPE_WEBHOOK_SECRETS=<sandbox-endpoint-signing-secret>
STRIPE_INGRESS_PORT=4242
