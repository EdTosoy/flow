{
  "name": "simulator",
  "sourceRoot": "libs/simulator/src",
  "projectType": "library",
  "tags": ["layer:simulator", "trust:runtime"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/simulator"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --test libs/simulator/test/*.test.ts"
      }
    }
  }
}
